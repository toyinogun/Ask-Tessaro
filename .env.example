# Local settings for `just dev`. `just init` copies this to .env (gitignored).
# Names follow PRD 14.3. No real secret belongs here before the cluster phase.

LOG_LEVEL=DEBUG
LOG_JSON=false

# Local dependencies (compose.yaml)
REDIS_URL=redis://localhost:6379/0
OPENFGA_API_URL=http://localhost:18080
# Set by `just authz-load` (spec 0004): the local store and the pinned model ID.
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
OPA_URL=http://localhost:8181
TEMPORAL_ADDRESS=localhost:7233
PRESIDIO_ANALYZER_URL=http://localhost:5002

# Our services on the laptop (`just dev <service>` picks the port: see justfile)
LLM_BASE_URL=http://localhost:18082/v1
GATEWAY_UPSTREAMS=http://localhost:18085/mcp

# Tokens (spec 0003). `just keys` fills the DEV_* keys and TOKEN_VERIFY_KEYS; `just dev`
# maps the adapter key onto TOKEN_SIGNING_KEY for zulip-adapter and the worker key for
# jml-worker. Leave TOKEN_SIGNING_KEY/KID empty here. TOKEN_TTL_SECONDS empty means 300.
TOKEN_SIGNING_KEY=
TOKEN_SIGNING_KID=
TOKEN_TTL_SECONDS=
TOKEN_VERIFY_KEYS=
DEV_ADAPTER_SIGNING_KEY=
DEV_WORKER_SIGNING_KEY=

# Privacy proxy (spec 0006). `just keys` fills the three keys; `just dataset` writes the directory.
# The agent's OpenAI client sends PROXY_CLIENT_KEY as its api_key. PROXY_FAIL_CLOSED must stay true.
# PROXY_UPSTREAM_API_KEY is required unless PROXY_UPSTREAM_URL is a loopback fake (http://localhost:...).
PROXY_UPSTREAM_URL=https://api.deepseek.com
PROXY_UPSTREAM_API_KEY=
PROXY_CLIENT_KEY=
PROXY_MAPPING_KEY=
PROXY_LOOKUP_KEY=
PROXY_DIRECTORY_PATH=dataset/build/directory.json
PROXY_MAPPING_TTL_HOURS=24
PROXY_FAIL_CLOSED=true
PROXY_SCORE_THRESHOLD=0.4
PROXY_ANALYZER_TIMEOUT_SECONDS=5
PROXY_UPSTREAM_TIMEOUT_SECONDS=60
LLM_MODEL_AGENT=deepseek-v4-pro
LLM_MODEL_TOOLS=deepseek-v4-flash

# Cluster scripts (spec 0007): `just netpol-proof` and `just ingress-smoke` refuse to run unless
# `kubectl config current-context` equals this. `just schemas` uses it too.
TESSARO_KUBE_CONTEXT=k3sprox-operator.tail62ceef.ts.net
